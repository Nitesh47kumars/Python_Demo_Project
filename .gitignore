```gitignore
# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
env/
.venv/
myenv/

# Environment variables
.env
.env.*
!.env.example

# Python tools
.pytest_cache/
.mypy_cache/
.ruff_cache/


# =========================
# FastAPI / Backend
# =========================

*.log


# =========================
# Node / React
# =========================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/

# Vite
.vite/


# =========================
# IDE / Editor
# =========================

.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db


# =========================
# Database / Local files
# =========================

*.sqlite
*.sqlite3
*.db


# =========================
# Secrets
# =========================

*.pem
*.key
```
